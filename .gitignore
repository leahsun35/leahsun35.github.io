# Ignore the contents of the _site directory and other cache directories
_site/
.sass-cache/

# Ignore the directory for local files during development
local/

# Ignore the Gemfile that is generated
Gemfile.lock

# Ignore files created by npm
node_modules
package-lock.json

# Ignore the vendor file at root level and bundle for alternative installation
/vendor/
.bundle/

# Ignore folders related to IDEs
.vscode/

# Ignore files created by MacOS
.DS_Store

# Jekyll build caches
.jekyll-cache/
.jekyll-metadata
.jekyll-assets-cache/
.asset-cache/

# Python helper scripts and notebooks
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/

# Local environment variables
.env
.env.*
!.env.example

# Package manager debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor temporary files and Windows metadata
*.swp
*.swo
*~
Thumbs.db
Desktop.ini
